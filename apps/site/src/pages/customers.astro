---
/** S1 · Customers. Publishes approved stories only; with none it shows a holding page and stays out of search. */
import { getCollection } from 'astro:content';
import Page from '~/layouts/Page.astro';
import PageHero from '~/components/PageHero.astro';

const all = await getCollection('stories', (s) => s.data.approved || import.meta.env.DEV);
const live = all.filter((s) => s.data.approved);
const featured = all.find((s) => s.data.featured) ?? all[0];
const cats = ['All', ...new Set(all.map((s) => s.data.category))];
const COLORS: Record<string, string> = { 'Inflatables & party': '#2C4FE0', 'Tents & furniture': '#0B7A55', 'AV & staging': '#B0306A', 'Tools & equipment': '#0E7490', 'Car rental': '#6D3FD6' };
const initials = (n: string) => n.replace(/[[\]]/g, '').split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---
<Page title="Customers" description="Stories from party, tent, AV and equipment rental companies running on Rent Hatch." vertical="auto" noindex={live.length === 0}>
  <PageHero eyebrow="Customers" dark={false} glow="#D4FF3A" lede="Real stories from party, tent, AV and equipment rental companies running on Rent Hatch.">
    Rental owners who got <span class="v">their weekends back.</span>
  </PageHero>

  {all.length === 0 ? (
    <section class="wrap" style="padding-bottom:100px">
      <div class="empty">
        <strong style="font:800 28px var(--font-display)">Our first customer stories are being written.</strong>
        <span style="color:#535C6B;line-height:1.55;max-width:60ch">We only publish stories customers have read and approved, in their own words. Running on Rent Hatch and happy to share how it went?</span>
        <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center"><a href="/contact?topic=sales" class="btn btn-ink">Tell us your story</a><a href="/demo" class="btn btn-line">Book a demo</a></div>
      </div>
    </section>
  ) : (
    <>
      {featured && (
        <section class="wrap" style="padding-bottom:40px">
          <div class="feat">
            <div class="stack" style="gap:18px;flex:1 1 520px;min-width:0">
              <span class="eyebrow" style="color:#8A93A3">Featured story · {featured.data.category}{!featured.data.approved && <span class="draft">Draft · not public</span>}</span>
              <blockquote>“{featured.data.quote}”</blockquote>
              <span style="display:flex;align-items:center;gap:12px"><span class="av">{initials(featured.data.person)}</span><span class="stack"><strong>{featured.data.person}</strong><span style="color:#A3ABB9;font-size:14px">{featured.data.role} · {featured.data.company}, {featured.data.city}</span></span></span>
            </div>
            <div class="metric"><strong class="mono">{featured.data.metric.split(' ')[0]}</strong><span>{featured.data.metric.split(' ').slice(1).join(' ')}</span></div>
          </div>
        </section>
      )}
      <section class="wrap stack" style="gap:22px;padding-bottom:100px" data-stories>
        <div class="cats" role="group" aria-label="Filter stories">{cats.map((c, i) => <button type="button" class="fchip" aria-pressed={i === 0 ? 'true' : 'false'} data-cat={c}>{c}</button>)}</div>
        <ul class="grid">
          {all.map((s) => (
            <li class="scard" data-cat={s.data.category}>
              <span class="chip" style={`align-self:flex-start;background:${COLORS[s.data.category]}1A;color:${COLORS[s.data.category]};font-size:12px;padding:4px 10px`}>{s.data.category}</span>
              {!s.data.approved && <span class="draft">Draft · not public</span>}
              <strong style="font:800 21px/1.2 var(--font-display)">{s.data.title}</strong>
              <span style="font-size:14px;color:#6B7383">{s.data.company} · {s.data.city}</span>
              <span class="mono" style="margin-top:auto;font-weight:600">{s.data.metric}</span>
            </li>
          ))}
        </ul>
        <div class="ask"><span><strong>Want to be featured?</strong> We'll write it with you and you approve every word.</span><a href="/contact?topic=sales" class="btn btn-ink" style="height:44px">Tell us your story</a></div>
      </section>
    </>
  )}
</Page>
<script>
  const root = document.querySelector<HTMLElement>('[data-stories]');
  root?.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('.fchip');
    if (!b) return;
    root.querySelectorAll('.fchip').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    root.querySelectorAll<HTMLElement>('.scard').forEach((c) => { c.hidden = b.dataset.cat !== 'All' && c.dataset.cat !== b.dataset.cat; });
  });
</script>
<style>
  .empty { display: flex; flex-direction: column; gap: 16px; align-items: center; text-align: center; padding: clamp(32px, 6vw, 64px); border-radius: 28px; border: 1.5px dashed #C9CED6; }
  .feat { display: flex; flex-wrap: wrap; gap: 32px; align-items: center; border-radius: 32px; background: #0B0D12; color: #fff; padding: clamp(28px, 4vw, 52px); }
  blockquote { margin: 0; font: 800 clamp(26px, 3vw, 40px)/1.15 var(--font-display); letter-spacing: -.02em; }
  .av { width: 44px; height: 44px; border-radius: 50%; background: #D4FF3A; color: #0B0D12; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; }
  .metric { flex: 1 1 260px; display: flex; flex-direction: column; gap: 6px; padding: 24px; border-radius: 22px; background: #141821; border: 1px solid #232835; }
  .metric strong { font-size: 52px; color: #D4FF3A; }
  .metric span { color: #A3ABB9; }
  .draft { display: inline-block; margin-left: 10px; padding: 3px 8px; border-radius: 999px; background: #FFF1DC; color: #8A4A00; font-size: 11px; font-weight: 700; letter-spacing: 0; text-transform: none; }
  .cats { display: flex; flex-wrap: wrap; gap: 8px; }
  .fchip { height: 40px; padding: 0 16px; border-radius: 999px; border: 1.5px solid #E3E5DC; background: #fff; color: #353C48; font: 600 14px var(--font-ui); cursor: pointer; }
  .fchip[aria-pressed="true"] { background: #0B0D12; color: #fff; border-color: #0B0D12; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 14px; }
  .scard { border-radius: 22px; background: #fff; border: 1px solid #E3E5DC; padding: 24px; display: flex; flex-direction: column; gap: 10px; min-height: 220px; }
  .ask { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; justify-content: space-between; padding: 22px 26px; border-radius: 22px; background: #F1F2EA; font-size: 15.5px; }
</style>

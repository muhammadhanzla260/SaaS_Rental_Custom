# Public URLs
PUBLIC_SITE_URL=https://renthatch.com
PUBLIC_APP_URL=https://app.renthatch.com

# Tracking (loaded only after cookie consent)
PUBLIC_GA_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_META_PIXEL_ID=

# Spam protection: Cloudflare Turnstile (optional; honeypot + timing always on)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Form delivery
PLATFORM_SMTP_URL=            # smtp://user:pass@host:587 — thank-you emails and inbox copies
SITE_MAIL_FROM="Rent Hatch <hello@renthatch.com>"
MESSAGING_DELIVERY=           # "live" sends for real; anything else writes to .data/outbox
CRM_WEBHOOK_URL=              # every form submission is POSTed here as JSON (HubSpot/Zapier/Make…)
INBOX_SALES=sales@renthatch.com
INBOX_SUPPORT=support@renthatch.com
INBOX_PARTNERS=partners@renthatch.com
INBOX_PRESS=press@renthatch.com
INBOX_JOBS=jobs@renthatch.com

# Social profiles (footer icons appear once set)
PUBLIC_SOCIAL_LINKEDIN=
PUBLIC_SOCIAL_YOUTUBE=
PUBLIC_SOCIAL_INSTAGRAM=
PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SITE_URL=https://renthatch.com

<script>
  import { track } from '~/scripts/track';
  // Revenue leak calculator.
  const roi = document.querySelector<HTMLElement>('[data-roi]');
  if (roi) {
    const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
    const out = (k: string, v: string) => roi.querySelectorAll<HTMLElement>(`[data-out="${k}"]`).forEach((el) => { el.textContent = v; });
    const calc = () => {
      const v: Record<string, number> = {};
      roi.querySelectorAll<HTMLInputElement>('input[data-k]').forEach((i) => { v[i.dataset.k!] = +i.value; });
      const fees = v.bk! * v.avg! * (v.miss! / 100) * 0.08;
      const bal = v.unpaid! * v.avg! * 0.7;
      const max = Math.max(fees, bal, 1);
      out('bk', String(v.bk)); out('avg', usd(v.avg!)); out('miss', `${v.miss}%`); out('unpaid', String(v.unpaid));
      out('total', usd(fees + bal)); out('fees', usd(fees)); out('bal', usd(bal)); out('hrs', `${Math.round(v.bk! * 12 / 60)} hours / month`);
      roi.querySelector<HTMLElement>('[data-bar="fees"]')!.style.width = `${Math.max(3, fees / max * 100)}%`;
      roi.querySelector<HTMLElement>('[data-bar="bal"]')!.style.width = `${Math.max(3, bal / max * 100)}%`;
    };
    roi.addEventListener('input', calc);
    calc();
  }
  document.addEventListener('rh:choice', (e) => {
    const d = (e as CustomEvent).detail;
    if (d.key === 'billing' && d.user) track('pricing_toggle', { billing: d.value, location: 'home' });
  });
</script>


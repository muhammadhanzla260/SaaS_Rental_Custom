{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_URL_OWNER",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "NEXT_PUBLIC_MAPBOX_TOKEN",
    "MAPBOX_SECRET_TOKEN",
    "APP_ENCRYPTION_KEY",
    "PLATFORM_OWNER_EMAIL",
    "PLATFORM_SMTP_URL",
    "PLATFORM_MAIL_FROM",
    "MESSAGING_DELIVERY",
    "APP_URL",
    "MESSAGING_OUTBOX_DIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

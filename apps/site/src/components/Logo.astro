---
/** The "open slot" mark: a 2x2 grid of tiles, the last one rotated open. */
interface Props { size?: number; animate?: boolean }
const { size = 34, animate = false } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="6.5" fill="#D4FF3A" /><g fill="#0B0D12"><rect x="5" y="5" width="6.2" height="6.2" rx="1.7" /><rect x="12.8" y="5" width="6.2" height="6.2" rx="1.7" /><rect x="5" y="12.8" width="6.2" height="6.2" rx="1.7" /><rect x="12.8" y="12.8" width="6.2" height="6.2" rx="1.7" transform="rotate(24 12.8 19)" class:list={[{ 'logo-lid': animate }]} /></g></svg>
<style>
  .logo-lid { transform-origin: 16px 19px; animation: lid 3s ease-in-out infinite; }
  @keyframes lid { 0%, 100% { transform: rotate(24deg); } 50% { transform: rotate(14deg); } }
</style>

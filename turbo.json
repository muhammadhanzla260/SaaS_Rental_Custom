{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_URL_OWNER",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "NEXT_PUBLIC_MAPBOX_TOKEN",
    "MAPBOX_SECRET_TOKEN",
    "APP_ENCRYPTION_KEY",
    "PLATFORM_OWNER_EMAIL",
    "PLATFORM_SMTP_URL",
    "PLATFORM_MAIL_FROM",
    "MESSAGING_DELIVERY",
    "APP_URL",
    "MESSAGING_OUTBOX_DIR",
    "PLATFORM_APP_DOMAIN",
    "R2_ENDPOINT",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET",
    "NEXT_PUBLIC_SITE_URL",
    "PUBLIC_SITE_URL",
    "PUBLIC_APP_URL",
    "PUBLIC_GA_ID",
    "PUBLIC_GOOGLE_ADS_ID",
    "PUBLIC_META_PIXEL_ID",
    "PUBLIC_TURNSTILE_SITE_KEY",
    "TURNSTILE_SECRET",
    "CRM_WEBHOOK_URL",
    "SITE_MAIL_FROM",
    "INBOX_SALES",
    "INBOX_SUPPORT",
    "INBOX_PARTNERS",
    "INBOX_PRESS",
    "INBOX_JOBS",
    "VERCEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        ".vercel/output/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

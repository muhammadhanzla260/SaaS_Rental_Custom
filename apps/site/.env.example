# Build-time settings (copy to apps/site/.env, then build). Form settings live in public/api/config.php.

# Public URLs. PUBLIC_APP_URL is where "Log in" and "Start free trial" go (the Vercel app).
PUBLIC_SITE_URL=https://renthatch.org
PUBLIC_APP_URL=https://app.renthatch.org

# Tracking (loaded only after cookie consent)
PUBLIC_GA_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_META_PIXEL_ID=

# Spam protection: Cloudflare Turnstile (optional; honeypot + timing always on).
# Put the matching secret in public/api/config.php.
PUBLIC_TURNSTILE_SITE_KEY=

# Social profiles (footer icons appear once set)
PUBLIC_SOCIAL_LINKEDIN=
PUBLIC_SOCIAL_YOUTUBE=
PUBLIC_SOCIAL_INSTAGRAM=
PUBLIC_SOCIAL_FACEBOOK=

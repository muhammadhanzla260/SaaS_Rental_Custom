---
/**
 * Document shell for every page: metadata, canonical + Open Graph, structured data, self-hosted
 * fonts, the cookie banner and the one shared script. `vertical` drives the two-site rule:
 *  - 'events' | 'cars': a vertical page; visiting it remembers that business (rh_vertical cookie).
 *  - 'auto': a shared page; the cookie picks which nav/footer variant shows, before first paint.
 *  - 'none': the start screen.
 */
import { Font } from 'astro:assets';
import CookieBanner from '~/components/CookieBanner.astro';
import { BRAND, SITE_URL, type Vertical } from '~/lib/site';
import '~/styles/global.css';

interface Props {
  title: string;
  description: string;
  vertical: Vertical | 'auto' | 'none';
  /** Open Graph image path; defaults to the per-page generated card. */
  og?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  bodyClass?: string;
}
const { title, description, vertical, og, jsonLd = [], noindex = false, bodyClass } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = SITE_URL + (path === '/' ? '' : path);
const look = vertical === 'cars' ? 'cars' : 'events';
const ogSlug = path === '/' ? 'home' : path.slice(1).replace(/\//g, '--');
const ogImage = new URL(og ?? `/og/${ogSlug}.png`, SITE_URL).href;
const fullTitle = title.includes(BRAND) ? title : `${title} · ${BRAND}`;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: BRAND,
  url: SITE_URL,
  logo: `${SITE_URL}/icon-512.png`,
};
const viewEvent = vertical === 'events' ? 'view_events' : vertical === 'cars' ? 'view_cars' : undefined;
const turnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<!doctype html>
<html lang="en" data-v={vertical === 'cars' ? 'cars' : 'events'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={look === 'cars' ? '#1A1036' : '#0B0D12'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {/* The vertical decision runs before paint so a shared page never flashes the wrong nav. */}
    {vertical === 'events' || vertical === 'cars'
      ? <script is:inline define:vars={{ v: vertical }}>document.cookie='rh_vertical='+v+'; Max-Age=31536000; Path=/; SameSite=Lax'+(location.protocol==='https:'?'; Secure':'');document.documentElement.dataset.v=v;</script>
      : <script is:inline>(function(){var m=document.cookie.match(/(?:^|; )rh_vertical=(events|cars)/);if(m)document.documentElement.dataset.v=m[1];})();</script>}
    {/* No font preloads: with font-display: swap text paints at once, and preloads would compete with first paint. */}
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-ui" />
    <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonLd])} />
    <slot name="head" />
  </head>
  <body id="top" class={bodyClass} data-view-event={viewEvent}>
    <a href="#main" class="skip">Skip to content</a>
    <slot />
    <CookieBanner />
    {turnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
    <script>
      import '~/scripts/site';
    </script>
  </body>
</html>
<style is:global>
  html[data-v="cars"] .v-events, html:not([data-v="cars"]) .v-cars { display: none !important; }
</style>

---
/** E1 · Event rental home. */
import Page from '~/layouts/Page.astro';
import Icon from '~/components/Icon.astro';
import Faq from '~/components/Faq.astro';
import { IC, SIGN_UP } from '~/lib/site';
import { PLANS, PRICES_FINAL, offersJsonLd } from '~/data/plans';

const GEARS = [
  { id: 'party', label: 'Party & inflatables', icon: IC.event, glow: '#2C4FE0' },
  { id: 'tents', label: 'Tents & furniture', icon: IC.tent, glow: '#0B7A55' },
  { id: 'av', label: 'AV & staging', icon: IC.av, glow: '#B0306A' },
  { id: 'tools', label: 'Tools & equipment', icon: IC.wrench, glow: '#0E7490' },
];
const HERO: Record<string, { no: string; cust: string; when: string; lines: [string, string][]; total: string; kpis: [string, string, string][] }> = {
  party: { no: 'Q-AUS-01043', cust: 'Maria Gonzalez · Birthday', when: 'Sat, Nov 7 · 1:00–6:00 PM · Cedar Park', lines: [['Castle Bounce House', '$325.00'], ['Popcorn Machine', '$175.00'], ['Damage waiver 10%', '$50.00'], ['Travel · 8.4 mi', '$21.00']], total: '$618.11', kpis: [['Deposit', '$185.43', '#D4FF3A'], ['Balance', 'Nov 7', '#fff'], ['Crew', 'Alex K.', '#fff']] },
  tents: { no: 'Q-DAL-00398', cust: 'Lee wedding · Reception', when: 'Sat, Nov 14 · Setup Fri 3 PM · Pickup Sun', lines: [['40×60 frame tent', '$2,400.00'], ['Round tables ×24', '$288.00'], ['Chiavari chairs ×190', '$760.00'], ['Dance floor 16×16', '$450.00']], total: '$4,413.28', kpis: [['Deposit 50%', '$2,206.64', '#D4FF3A'], ['Setup crew', '4 people', '#fff'], ['Pickup', 'Sun 10 AM', '#fff']] },
  av: { no: 'Q-HOU-00221', cust: 'Bayou Tech · Product launch', when: 'Thu, Nov 12 · 6:00–10:00 PM · Downtown', lines: [['LED wall 10×6', '$1,800.00'], ['PA system 2,000 W', '$450.00'], ['Uplight kit ×12', '$240.00'], ['AV technician · 6 h', '$390.00']], total: '$3,117.60', kpis: [['Deposit 30%', '$935.28', '#D4FF3A'], ['Tech on site', '1 person', '#fff'], ['Load-in', '2:00 PM', '#fff']] },
  tools: { no: 'Q-DAL-00412', cust: 'Greenway Church · Fall fair', when: 'Fri–Sun, Nov 13–15 · Delivery & setup', lines: [['20×40 frame tent', '$1,150.00'], ['Banquet tables ×20', '$240.00'], ['Chiavari chairs ×160', '$640.00'], ['Generator 7.5 kW', '$185.00']], total: '$2,431.63', kpis: [['Deposit 50%', '$1,215.82', '#D4FF3A'], ['Setup crew', '3 people', '#fff'], ['Pickup', 'Mon 9 AM', '#fff']] },
};
// [title, sub, icon, bg, fg, iconBg, iconFg]
const FLOATS: Record<string, [string, string, string, string, string, string, string][]> = {
  party: [['Deposit paid', '$185.43 · card •4242', 'M3 6h18v12H3zM3 10h18', '#D4FF3A', '#0B0D12', '#0B0D12', '#D4FF3A'], ['Reminder sent', '3 days before the party', IC.mail, '#fff', '#10131A', '#E6ECFF', '#233FB8'], ['Crew is 5 min away', 'Customer texted automatically', IC.crew, '#2C4FE0', '#fff', '#fff', '#2C4FE0']],
  tools: [['Delivery booked', 'Fri 8:00 AM · Truck 1', IC.van, '#fff', '#10131A', '#E6ECFF', '#233FB8'], ['Contract e-signed', 'by Greenway Church', IC.check, '#D4FF3A', '#0B0D12', '#0B0D12', '#D4FF3A'], ['Setup photos saved', '3 photos · 100% checklist', IC.check, '#2C4FE0', '#fff', '#fff', '#2C4FE0']],
  tents: [['Setup crew booked', 'Fri 3 PM · 4 people', IC.van, '#fff', '#10131A', '#E6ECFF', '#233FB8'], ['Deposit paid', '$2,206.64 · card', 'M3 6h18v12H3zM3 10h18', '#D4FF3A', '#0B0D12', '#0B0D12', '#D4FF3A'], ['Weather watch on', 'Rain check ready if needed', IC.check, '#2C4FE0', '#fff', '#fff', '#2C4FE0']],
  av: [['Load-in confirmed', 'Thu 2:00 PM · dock B', IC.van, '#fff', '#10131A', '#E6ECFF', '#233FB8'], ['Contract e-signed', 'by Bayou Tech', IC.check, '#D4FF3A', '#0B0D12', '#0B0D12', '#D4FF3A'], ['Tech on site', 'EVENT START 6:02 PM', IC.crew, '#2C4FE0', '#fff', '#fff', '#2C4FE0']],
};
const FLOAT_POS = [['0px', '8px'], ['58%', '42%'], ['6%', '78%']];
const MARQ = ['Bounce houses', 'Water slides', 'Tents & canopies', 'Tables & chairs', 'AV & staging', 'Concessions', 'Party equipment', 'Event furniture', 'Generators & power', 'Tools & equipment', 'Linens & decor', 'Dunk tanks & games'];
const PAINS = [
  ['Double-booked the same bounce house. Again.', 'Two families, one castle, one very awkward phone call.', 'Every unit is checked before you book', 'Live availability refuses a booking when all units are out, and suggests what is free instead.', 'Quotes & bookings'],
  ['Chasing deposits by text.', '“I’ll pay Friday, promise.” They didn’t.', 'Customers sign and pay online', 'The quote link takes an e-signature and the deposit. The balance charges itself on event day.', 'Payments'],
  ['Leads go cold while you’re on a job.', 'By the time you call back, they booked someone else.', 'Every lead gets a reply in minutes', 'An instant auto-reply, a text to your team and follow-ups on day 1, 3 and 7 until they book.', 'Leads'],
  ['“Where are you guys?”', 'Five calls from the birthday mom before 10 AM.', 'Customers get a 5-minute heads-up', 'Crews tap Start En Route. Customers get a text when they leave and another when they are 5 minutes out.', 'Crew portal'],
  ['Forgot the travel fee. And the overtime.', 'Small misses on every order add up to real money.', 'Priced to the cent, every time', 'Travel by distance, overtime by the minute, surfaces, waivers and tax are added automatically.', 'Pricing engine'],
  ['Rain. Refund? Reschedule? Argue?', 'Weather wrecks a Saturday and your cash flow with it.', 'One-tap rain checks', 'Turn what they paid into credit for a new date, release the items and stop the balance charge.', 'Rain checks'],
];
const KINDS = [
  ['Inflatables & party', 'Bounce houses, slides, games and concessions, delivered and set up by your crews.', IC.event, '#E6ECFF', '#2C4FE0', ['Staffed events', 'Overtime', 'Rain checks'], 'party'],
  ['Tents & event furniture', 'Canopies, tables, chairs and dance floors booked by quantity across multi-day events.', IC.tent, '#E3F5EC', '#0B7A55', ['Quantities', 'Multi-day', 'Setup crews'], 'tents'],
  ['AV, staging & lighting', 'Screens, sound and stages with technicians, load-in times and on-site checklists.', IC.av, '#FCE8F1', '#B0306A', ['Technicians', 'Load-in', 'Packages'], 'av'],
  ['Tools & equipment', 'Generators, lifts and site gear rented by the day or week, picked up or delivered.', IC.wrench, '#E0F2F7', '#0E7490', ['Daily & weekly', 'Pickup', 'Damage checks'], 'tools'],
] as const;
const TABS = [
  ['Quote & book', 'Build an order in a minute. Prices, travel, overtime and tax add themselves, and double bookings are refused.'],
  ['Get paid', 'Customers e-sign and pay the deposit online. Balances charge on event day, receipts send themselves.'],
  ['Automate', 'Quotes, confirmations, reminders and review requests go out from your own email and number.'],
  ['Dispatch crews', 'Crews follow a 5-phase checklist with photo proof. You watch them live on a map.'],
  ['See the numbers', '32 ready-made reports: sales, receivables, rain checks, commissions and more.'],
  ['Your brand', 'Your logo, colours and domain on quotes, emails, invoices and the crew app.'],
];
const ORDER_ROWS = [['Castle Bounce House', 'Staffed · 4 h + 1 h overtime', '$325.00'], ['Popcorn Machine', 'Staffed · 5 h', '$175.00'], ['Damage waiver', '10% of rentals', '$50.00'], ['Travel fee', '8.4 mi past free zone × $2.50', '$21.00'], ['Sales tax', '8.25%', '$47.11']];
const AUTOS = [['Quote sent', 'Sign & pay link', 'Instantly', '#fff', IC.mail], ['Booking confirmed', 'Receipt + signed agreement', 'On deposit', '#fff', IC.mail], ['Pre-event reminder', 'Arrival window & setup spot', '3 days before', '#fff', IC.mail], ['Contact check', 'Text to the on-site contact', '2 days before', '#fff', IC.chat], ['Balance charged', '$432.68 + receipt', 'Event day 8 AM', '#D4FF3A', 'M3 6h18v12H3zM3 10h18'], ['Review request', 'Links to your reviews', 'Day after', '#fff', IC.mail]];
const PHASES = [['Pre-departure', '100%'], ['Load + photo', '100%'], ['Arrival checks', '100%'], ['Setup & start', '67%'], ['Close-out', '0%']];
const BARS = [.42, .35, .55, .48, .62, .58, .7, .64, .78, .74, .88, 1];
const SWATCHES = [['cobalt', '#2C4FE0'], ['emerald', '#0B7A55'], ['ember', '#C2410C'], ['berry', '#B0306A'], ['violet', '#6D3FD6'], ['teal', '#0E7490'], ['ink', '#10131A'], ['volt', '#D4FF3A']];
const STEPS = [['1', 'Create your workspace', 'Business name, your URL and a password. That is the whole sign-up.', '2 minutes'], ['2', 'Brand it', 'Upload your logo, pick your colour and connect your email. Everything customers see looks like you.', '15 minutes'], ['3', 'Add what you rent', 'Import products, prices and units from a spreadsheet, or add them one by one.', 'An hour or so'], ['4', 'Send your first quote', 'Customers sign and pay online. Reminders, receipts and the balance take care of themselves.', 'Same day']];
const SLIDERS = [['bk', 'Bookings per month', 5, 400, 5, 60], ['avg', 'Average order value', 100, 3000, 50, 650], ['miss', 'Orders missing a travel or overtime fee', 0, 40, 1, 15], ['unpaid', 'Balances not collected each month', 0, 30, 1, 4]] as const;
const FACTS = [['32', 'ready-made reports, from month-to-date sales to commissions'], ['13', 'emails and texts that send themselves, on timings you set'], ['5', 'crew checklist phases with photo proof, from warehouse to close-out'], ['8', 'team roles, from owner and sales to coach and crew']];
const SEC = [['Your data, walled off', 'Every business is isolated from every other one, enforced in the database.', IC.shield], ['Card data never touches us', 'Payments run through Stripe’s hosted fields and your own Stripe account.', 'M3 6h18v12H3zM3 10h18'], ['Passkeys & two-step sign-in', 'Modern sign-in for owners and staff. Crews only see their own jobs.', IC.lock], ['Full audit log', 'Every change to an order, payment or checklist is recorded with who and when.', 'M5 4h14v16H5zM9 8h6M9 12h6M9 16h3'], ['Encrypted secrets', 'Mail passwords and API keys are encrypted and never shown again.', 'M12 2 3 7v6c0 5 4 8 9 9 5-1 9-4 9-9V7zM9 12l2 2 4-4'], ['GPS only on the job', 'Crew location is shared only between Start En Route and arrival.', IC.crew]];
const INTEG = ['Stripe', 'Google Workspace', 'Microsoft 365', 'Zoho Mail', 'Any SMTP server', 'SMS provider', 'Mapbox maps', 'CSV import & export', 'API & webhooks · soon'];
const FAQS: [string, string][] = [
  ['Does it work for tents, AV and equipment, not just bounce houses?', 'Yes. Every product can be priced as staffed, drop-off or customer pickup, with its own included hours, overtime, cleaning buffer and number of units. Tents, chairs, AV and tools work the same way.'],
  ['Can I bring my products and customers from another system?', 'Yes. Import products, prices and customers from a spreadsheet. On Growth and Scale we help you move your data and check that prices match your old system to the cent.'],
  ['Do I need a contract?', 'No. Plans are month to month, or yearly with 20% off. Cancel any time from your settings and export your data.'],
  ['Can emails come from my own address and domain?', 'Yes. Connect your own mail server once (Google Workspace, Microsoft 365, Zoho or any SMTP) and every quote, receipt and reminder comes from you. Quote and pay links can use your own domain.'],
  ['Do my crews need to install an app?', 'No install needed. Crews open the crew portal on their phone browser and add it to the home screen. GPS is only on while they are driving to a job.'],
  ['How do card payments work?', 'Payments run through your own Stripe account, so money goes straight to you. Card numbers never touch our servers. Stripe charges its standard processing fees.'],
  ['Is my data safe?', 'Each business is walled off from every other one, passwords and mail credentials are encrypted, and every change is written to an audit log. Passkeys and two-step sign-in are built in.'],
  ['What happens when the trial ends?', 'Pick a plan to keep going. If you do nothing, your workspace pauses and nothing is deleted for 30 days.'],
];
const app = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Rent Hatch', applicationCategory: 'BusinessApplication', operatingSystem: 'Web',
  description: 'Rental management software for party, event and equipment rental businesses.', offers: offersJsonLd(),
};
---
<Page
  title="Rent Hatch · Event & equipment rental software"
  description="Quotes, bookings, e-signatures, deposits, crews and reports in one system for party, tent, AV and equipment rental companies. Start a free trial."
  vertical="events"
  nav="dark"
  active="home"
  jsonLd={[app]}
>
  <!-- HERO -->
  <section class="hero" data-scope data-gear="party">
    <div class="grid-bg"></div>
    <div class="glow hero-glow"></div>
    <div class="glow" style="width:420px;height:420px;background:#D4FF3A;opacity:.12;left:-120px;bottom:-160px"></div>
    <div class="wrap hero-in">
      <div class="hero-copy">
        <a href="/events/features#crew" class="chip rise new-chip"><span>NEW</span>Crew portal with live GPS &amp; photo checklists →</a>
        <h1 class="disp rise" style="--d:80ms;font-size:clamp(46px,5.6vw,80px)">Run your rental business <span class="v">without the chaos.</span></h1>
        <p class="rise hero-lede" style="--d:160ms">Quotes, bookings, e-signatures, deposits, crews and reports in one system, built for rental companies from day one.</p>
        <div class="rise stack" style="--d:240ms;gap:10px">
          <span id="gear-l" class="hint">See it with your kind of gear</span>
          <div class="seg" role="radiogroup" aria-labelledby="gear-l" data-choice="gear" data-url>
            {GEARS.map((g, i) => <button type="button" class="segb" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-value={g.id}><Icon d={g.icon} size={20} />{g.label}</button>)}
          </div>
        </div>
        <div class="rise stack" style="--d:300ms;gap:14px">
          <div class="btns"><a href={SIGN_UP} class="btn btn-volt" data-track="start_trial" data-where="hero">Start free trial<Icon d={IC.arrow} size={18} width={2.2} /></a><a href="/demo" class="btn btn-ghost">Book a 20-min demo</a></div>
          <span class="hint" style="color:#8A93A3">Free trial · No card needed · Set up with a guided 6-step wizard</span>
        </div>
      </div>

      <div class="hero-vis">
        {GEARS.map((g, gi) => {
          const h = HERO[g.id]!;
          return (
            <div class="hero-gear" data-when={`gear:${g.id}`} hidden={gi !== 0} role="img" aria-label={`A booked rental order: ${h.cust}, total ${h.total}, deposit paid`}>
              <div class="win">
                <div class="win-bar"><span style="background:#FF5F57"></span><span style="background:#FEBC2E"></span><span style="background:#28C840"></span><span class="mono">app.renthatch.com/orders/{h.no}</span></div>
                <div class="win-body">
                  <div class="between"><span class="stack" style="gap:3px"><span class="mono" style="font-size:12px;color:#8A93A3">{h.no}</span><strong style="font-size:20px">{h.cust}</strong></span><span class="chip" style="background:#1F3A2C;color:#3DD39A;font-size:12px;padding:6px 12px">Booked</span></div>
                  <div style="font-size:13px;color:#8A93A3">{h.when}</div>
                  <div class="order">
                    {h.lines.map(([k, v], i) => <div class="row" style={`animation:slidein .5s var(--ease-out) both;animation-delay:${200 + i * 120}ms`}><span>{k}</span><span class="mono">{v}</span></div>)}
                    <div class="total"><strong>Total</strong><strong class="mono" style="font-size:30px;animation:countin .8s .6s both">{h.total}</strong></div>
                  </div>
                  <div class="kpis">{h.kpis.map(([k, v, c]) => <div><div style="font-size:11.5px;color:#8A93A3">{k}</div><div class="mono" style={`font-size:17px;font-weight:600;color:${c}`}>{v}</div></div>)}</div>
                </div>
              </div>
              {FLOATS[g.id]!.map(([t, s, icon, bg, fg, ib, ic], i) => (
                <div class="cyc float" aria-hidden="true" style={`--d:${i * 3}s;left:${FLOAT_POS[i]![0]};top:${FLOAT_POS[i]![1]};background:${bg};color:${fg}`}>
                  <span class="float-ic" style={`background:${ib}`}><Icon d={icon} size={18} stroke={ic} width={2.4} /></span>
                  <span class="stack" style="gap:1px">{t}<span style="font-size:12px;font-weight:500;opacity:.85">{s}</span></span>
                </div>
              ))}
            </div>
          );
        })}
      </div>
    </div>
    <div class="marq-wrap">
      <ul class="marq" aria-label="Built for these rental businesses">
        {[...MARQ, ...MARQ].map((t, i) => <li class="chip" aria-hidden={i >= MARQ.length ? 'true' : undefined}><span style={`background:${['#D4FF3A', '#2C4FE0', '#3DD39A', '#F5B04C'][i % 4]}`}></span>{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- PAINS → FIXES -->
  <section class="wrap sec" data-scope style="padding-bottom:40px">
    <div class="rv sec-head">
      <div class="stack" style="gap:16px;max-width:720px"><span class="eyebrow">Sound familiar?</span><h2 class="h2">The problems every rental owner knows. <span style="color:#2C4FE0">Fixed.</span></h2></div>
      <button type="button" class="btn btn-line" data-flip-all data-on="Show the problems" data-off="Fix them all">Fix them all</button>
    </div>
    <div class="flips">
      {PAINS.map(([pain, painSub, fix, fixSub, where]) => (
        <button type="button" class="flip rv" aria-pressed="false">
          <span class="flip-in" style="display:block">
            <span class="face" style="background:#fff;border:1px solid #E3E5DC">
              <span class="between"><span class="chip tag-bad">✕ PROBLEM</span><span style="font-size:13px;color:#6B7383">Tap to fix →</span></span>
              <strong class="flip-t">{pain}</strong>
              <span class="flip-s">{painSub}</span>
            </span>
            <span class="face back" style="background:#0B0D12;color:#fff">
              <span class="between"><span class="chip tag-good">✓ FIXED</span><span style="font-size:13px;color:#8A93A3">{where}</span></span>
              <strong class="flip-t">{fix}</strong>
              <span class="flip-s" style="color:#A3ABB9">{fixSub}</span>
            </span>
          </span>
        </button>
      ))}
    </div>
  </section>

  <!-- KINDS -->
  <section class="wrap sec" style="padding-top:100px;padding-bottom:20px">
    <div class="rv sec-head"><div class="stack" style="gap:16px;max-width:760px"><span class="eyebrow">Made for event rental</span><h2 class="h2">Whatever you deliver, it knows how you work</h2></div><p class="lede" style="max-width:420px">Staffed events, drop-offs or customer pickups. Units, buffers, crews and fees all work the way your kind of rental does.</p></div>
    <div class="grid-auto" style="--min:260px">
      {KINDS.map(([t, s, icon, bg, fg, tags, gear]) => (
        <a href={`/events/how-it-works?gear=${gear}`} class="card rv kind">
          <span class="kind-blob" style={`background:${bg}`}></span>
          <span class="kind-ic" style={`background:${fg}`}><Icon d={icon} size={28} stroke="#fff" /></span>
          <strong class="kind-t">{t}</strong>
          <span style="font-size:15px;line-height:1.5;color:#535C6B">{s}</span>
          <span class="tags">{tags.map((g) => <span class="chip">{g}</span>)}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- PRODUCT TOUR -->
  <section class="sec" style="padding-top:110px;padding-bottom:110px">
    <div class="wrap stack" style="gap:44px" data-scope data-tour="5500" data-tab="0">
      <div class="rv stack" style="gap:16px;max-width:760px"><span class="eyebrow">How Rent Hatch runs your week</span><h2 class="h2">From first enquiry to the last receipt, on autopilot</h2></div>
      <div class="tour">
        <div role="tablist" aria-label="Product tour" class="tour-tabs" data-choice="tab">
          {TABS.map(([title, sub], i) => (
            <button type="button" role="tab" class="tabb" id={`tour-t${i}`} aria-controls={`tour-p${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-value={String(i)}>
              <span class="tab-h"><span class="mono">0{i + 1}</span>{title}</span>
              <span class="tab-more"><span class="tab-s">{sub}</span><span class="tab-bar"><span class="prog"></span></span></span>
            </button>
          ))}
        </div>
        <div class="tour-stage">
          <div class="glow" style="width:400px;height:400px;background:#2C4FE0;opacity:.35;left:-100px;bottom:-150px"></div>
          <div role="tabpanel" id="tour-p0" aria-labelledby="tour-t0" data-when="tab:0" class="mock mock-card">
            <div class="between" style="margin-bottom:6px"><strong style="font-size:17px">New order · Sat, Nov 7</strong><span class="chip" style="background:#E6ECFF;color:#233FB8;font-size:12px;padding:5px 10px">Auto-priced</span></div>
            <div style="font-size:13px;color:#535C6B;margin-bottom:10px">1:00–6:00 PM · Cedar Park · 18.4 mi from warehouse</div>
            {ORDER_ROWS.map(([k, s, v], i) => <div class="row" style={`animation:slidein .5s both;animation-delay:${200 + i * 160}ms`}><span>{k}<span style="display:block;font-size:12px;color:#596170">{s}</span></span><span class="mono">{v}</span></div>)}
            <div class="total"><strong>Total</strong><strong class="mono" style="font-size:32px;animation:countin .8s 1.4s both">$618.11</strong></div>
            <div class="refused">✕ Third Castle Bounce House refused: 2 of 2 already booked that afternoon</div>
          </div>
          <div role="tabpanel" id="tour-p1" aria-labelledby="tour-t1" data-when="tab:1" hidden class="mock pay">
            <div class="phone">
              <div style="font:800 22px/1.05 var(--font-display)">Your party is almost booked</div>
              <div class="pbox"><span class="between"><span>Total</span><span class="mono">$618.11</span></span><span class="between" style="font-weight:700"><span>Deposit today</span><span class="mono">$185.43</span></span></div>
              <div class="pbox" style="padding:10px 12px"><div style="font-size:11px;color:#535C6B">Sign the rental agreement</div><svg width="220" height="56" viewBox="0 0 330 90" aria-hidden="true"><path d="M10 60 C 30 10, 50 10, 45 60 S 70 70, 80 40 S 100 20, 105 55 C 110 70, 125 40, 140 45 S 160 70, 175 35 C 185 20, 190 70, 205 55 S 230 30, 245 50 S 280 60, 320 30" fill="none" stroke="#10131A" stroke-width="4" stroke-linecap="round" stroke-dasharray="700" style="--len:700;animation:drawl 1.6s .3s cubic-bezier(.4,0,.2,1) both" /></svg></div>
              <div class="paid">✓ Paid · Booked</div>
            </div>
            <div class="stack" style="gap:12px;max-width:240px">
              <div class="chip" style="background:#D4FF3A;color:#0B0D12;animation:slidein .5s 2.3s both;white-space:normal">Deposit $185.43 paid by card</div>
              <div class="chip" style="background:#fff;color:#10131A;animation:slidein .5s 2.6s both;white-space:normal">Balance $432.68 auto-charges on event day</div>
              <div class="chip" style="background:#141821;color:#fff;border:1px solid #2E3442;animation:slidein .5s 2.9s both;white-space:normal">Signed agreement emailed</div>
            </div>
          </div>
          <div role="tabpanel" id="tour-p2" aria-labelledby="tour-t2" data-when="tab:2" hidden class="mock stack" style="width:min(100%,560px);gap:10px;position:relative">
            {AUTOS.map(([t, s, w, bg, icon], i) => (

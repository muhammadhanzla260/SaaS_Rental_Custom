---
/** E4 · Pricing for event and equipment rental. */
import Page from '~/layouts/Page.astro';
import Faq from '~/components/Faq.astro';
import { SIGN_UP } from '~/lib/site';
import { ADDONS, COMPARE, ENTERPRISE, PLANS, PLAN_DETAILS, PRICES_FINAL, YEARLY_DISCOUNT, offersJsonLd } from '~/data/plans';

const FAQS: [string, string][] = [
  ['Is there a free trial?', 'Yes. Start free with no card. When the trial ends, pick a plan or your workspace pauses, and nothing is deleted for 30 days.'],
  ['Can I change plans later?', 'Any time. Upgrades apply straight away and are prorated. Downgrades apply at the next billing date.'],
  ['Do you take a percentage of my bookings?', 'No. You pay your plan. Card processing goes through your own Stripe account at Stripe’s standard rates.'],
  ['What counts as a location?', 'A branch or depot with its own address, timezone and tax. Extra warehouses inside one location are free.'],
  ['What if I need more SMS?', 'Extra SMS bundles are available on every plan that includes texts, and you can cap your monthly spend.'],
  ['Can I cancel?', 'Yes, from settings, with no fee. Export your customers, orders and payments to CSV first.'],
];
const app = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Rent Hatch', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', offers: offersJsonLd() };
const planData = JSON.stringify(PLANS.map(({ id, name, monthly, yearly, locations, users }) => ({ id, name, monthly, yearly, locations, users })));
---
<Page
  title="Pricing · Event rental software"
  description="Simple plans for party, tent, AV and equipment rental businesses. Every plan includes the full booking and payment engine. Free trial, no card needed."
  vertical="events"
  active="pricing"
  jsonLd={[app]}
>
  <div data-scope data-billing="yearly">
    <section class="wrap hero">
      <span class="eyebrow rise">Pricing</span>
      <h1 class="disp rise" style="--d:80ms;font-size:clamp(46px,6vw,84px);max-width:960px">Pay for the size of your business, <span style="color:#2C4FE0">not for every feature.</span></h1>
      <p class="lede rise" style="--d:160ms">Pricing for event and equipment rental. Every plan includes the full booking and payment engine. Bigger plans add locations, crews and help moving over.</p>
      <div class="seg light rise" style="--d:240ms" role="radiogroup" aria-label="Billing period" data-choice="billing">
        <button type="button" class="segb" role="radio" aria-checked="false" data-value="monthly" style="height:44px">Monthly</button>
        <button type="button" class="segb" role="radio" aria-checked="true" data-value="yearly" style="height:44px">Yearly<span class="soon" style="background:#0B7A55">Save {YEARLY_DISCOUNT}%</span></button>
      </div>
    </section>

    <section class="wrap stack" style="padding-bottom:30px;gap:18px">
      <div class="plans">
        {PLANS.map((p, i) => (
          <div class:list={['rise plan', { pop: p.popular }]} style={`--d:${i * 70}ms`}>
            {p.popular && <span class="chip pop-tag">Most popular</span>}
            <h2 class="pname">{p.name}</h2>
            <span class="who">{p.who}</span>
            <span class="price"><strong class="mono"><span data-when="billing:yearly">${p.yearly}</span><span data-when="billing:monthly" hidden>${p.monthly}</span></strong><span style="font-size:14px;opacity:.65">/ month</span></span>
            <span class="billed"><span data-when="billing:yearly">billed yearly</span><span data-when="billing:monthly" hidden>billed monthly</span></span>
            <a href={`${SIGN_UP}?plan=${p.id}`} class="btn pbtn" data-track="start_trial" data-where={`pricing-${p.id}`}>Start free trial</a>
            <ul class="ticks">{PLAN_DETAILS[p.id].map((f) => <li><span aria-hidden="true">✓</span>{f}</li>)}</ul>
          </div>
        ))}
        <div class="rise plan" style="--d:210ms">
          <h2 class="pname">{ENTERPRISE.name}</h2>
          <span class="who">{ENTERPRISE.who}</span>
          <span class="price"><strong class="mono" style="font-size:40px">Custom</strong></span>
          <span class="billed">annual agreement</span>
          <a href="/demo?size=enterprise" class="btn pbtn">Talk to sales</a>
          <ul class="ticks">{ENTERPRISE.highlights.map((f) => <li><span aria-hidden="true">✓</span>{f}</li>)}</ul>
        </div>
      </div>
      <div class="between" style="flex-wrap:wrap;font-size:13.5px;color:#6B7383">
        <span>{PRICES_FINAL ? 'Prices in USD, before tax.' : 'Sample prices. Final pricing to be confirmed.'}</span>
        <span>Card processing is billed by Stripe at their standard rates. We never take a cut of your payments.</span>
      </div>
    </section>

    <!-- ESTIMATOR -->
    <section class="wrap est-sec">
      <div class="rv stack" style="flex:1 1 380px;min-width:0;gap:16px"><span class="eyebrow">Estimate your bill</span><h2 class="h2" style="font-size:clamp(34px,4vw,52px)">What would you pay?</h2><p class="lede">Pick your size and the add-ons you'd use. The estimate updates as you go.</p></div>
      <div class="card rv est" data-est data-plans={planData} data-addons={JSON.stringify(ADDONS)}>
        <div class="stack" style="gap:8px"><div class="between"><label for="est-loc" style="font-size:15px">Locations</label><output class="mono" for="est-loc" data-o="loc" style="font-weight:700">2</output></div><input id="est-loc" type="range" min="1" max="12" value="2" class="range ink" /></div>
        <div class="stack" style="gap:8px"><div class="between"><label for="est-usr" style="font-size:15px">Team members</label><output class="mono" for="est-usr" data-o="usr" style="font-weight:700">8</output></div><input id="est-usr" type="range" min="1" max="40" value="8" class="range ink" /></div>
        <label class="add"><span class="add-l"><input type="checkbox" id="est-sms" checked /><span class="stack"><strong style="font-size:15px">SMS reminders</strong><span data-o="smsNote" style="font-size:13px;color:#535C6B">Included in Growth</span></span></span><span class="mono" data-o="smsPrice" style="font-size:14px">Included</span></label>
        <label class="add"><span class="add-l"><input type="checkbox" id="est-mig" /><span class="stack"><strong style="font-size:15px">Help moving your data</strong><span data-o="migNote" style="font-size:13px;color:#535C6B">Guided migration included</span></span></span><span class="mono" data-o="migPrice" style="font-size:14px">Included</span></label>
        <div class="est-total" aria-live="polite"><span class="stack"><strong style="font-size:15px"><span data-o="plan">Growth</span> plan</strong><span data-o="note" style="font-size:13px;color:#535C6B">Growth fits 2 locations and 8 people · billed yearly</span></span><strong class="mono" style="font-size:40px"><span data-o="total">$103</span><span style="font-size:15px;color:#535C6B"> / mo</span></strong></div>
        <a href={SIGN_UP} class="btn btn-ink" data-o-href style="align-self:flex-start" data-track="start_trial" data-where="estimator">Start free trial on <span data-o="plan2">Growth</span></a>
      </div>
    </section>

    <!-- COMPARISON -->
    <section class="wrap stack" style="padding-top:80px;padding-bottom:40px;gap:22px">
      <div class="rv stack" style="gap:14px"><span class="eyebrow">Compare plans</span><h2 class="h2" style="font-size:clamp(34px,4vw,52px)">Everything, side by side</h2></div>
      <div class="cmp-scroll">
        <table class="ptab">
          <caption class="sr-only">Plan comparison</caption>
          <thead><tr><th scope="col" class="feat">Feature</th>{[...PLANS.map((p) => p.name), ENTERPRISE.name].map((n) => <th scope="col" style={n === 'Growth' ? 'color:#2C4FE0' : undefined}>{n}</th>)}</tr></thead>
          {COMPARE.map(([group, rows], gi) => (
            <tbody data-group>
              <tr><th colspan="5" scope="colgroup" class="gcell"><button type="button" class="grp" aria-expanded={gi === 0 ? 'true' : 'false'}>{group}<span aria-hidden="true" class="chev">⌄</span></button></th></tr>
              {rows.map(([k, ...c]) => (
                <tr class="grow" hidden={gi !== 0}><th scope="row">{k}</th>{c.map((v) => <td class={v === '✓' ? 'yes' : v === '—' ? 'no' : 'mono'}>{v === '✓' ? <><span aria-hidden="true">✓</span><span class="sr-only">Included</span></> : v === '—' ? <><span aria-hidden="true">—</span><span class="sr-only">Not included</span></> : v}</td>)}</tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </section>
  </div>

  <section class="wrap faq-sec">
    <div class="rv stack" style="flex:1 1 320px;gap:16px"><span class="eyebrow">Billing questions</span><h2 class="h2" style="font-size:clamp(34px,3.6vw,48px)">The fine print, in plain words</h2><a href="/demo" style="font-weight:650;color:#2C4FE0">Talk to sales →</a></div>
    <div style="flex:999 1 560px;min-width:0"><Faq items={FAQS} /></div>
  </section>
</Page>

<script>
  import { track } from '~/scripts/track';
  type P = { id: string; name: string; monthly: number; yearly: number; locations: number | null; users: number | null };
  const est = document.querySelector<HTMLElement>('[data-est]');
  const scope = document.querySelector<HTMLElement>('[data-billing]');
  if (est && scope) {
    const plans: P[] = JSON.parse(est.dataset.plans!);
    const addons = JSON.parse(est.dataset.addons!);
    const $ = (id: string) => est.querySelector<HTMLInputElement>(id)!;
    const out = (k: string, v: string) => est.querySelectorAll(`[data-o="${k}"]`).forEach((el) => { el.textContent = v; });
    const link = est.querySelector<HTMLAnchorElement>('[data-o-href]')!;
    const base = link.href;
    const render = () => {
      const loc = +$('#est-loc').value, usr = +$('#est-usr').value;
      const yearly = scope.dataset.billing === 'yearly';
      const p = plans.find((x) => (x.locations === null || loc <= x.locations) && (x.users === null || usr <= x.users)) ?? plans[plans.length - 1]!;
      const starter = p.id === 'starter';
      const sms = $('#est-sms').checked && starter ? addons.smsStarterMonthly : 0;
      const mig = $('#est-mig').checked && starter;
      out('loc', String(loc)); out('usr', String(usr)); out('plan', p.name); out('plan2', p.name);
      out('smsNote', starter ? 'Add-on on Starter' : `Included in ${p.name}`); out('smsPrice', starter ? `+$${addons.smsStarterMonthly}` : 'Included');
      out('migNote', starter ? 'One-time fee' : p.id === 'growth' ? 'Guided migration included' : 'Done for you, included'); out('migPrice', starter ? `+$${addons.migrationStarterOnce} once` : 'Included');
      out('note', `${p.name} fits ${loc} location${loc > 1 ? 's' : ''} and ${usr} ${usr > 1 ? 'people' : 'person'} · billed ${yearly ? 'yearly' : 'monthly'}${mig ? ` · + $${addons.migrationStarterOnce} one-time` : ''}`);
      out('total', `$${(yearly ? p.yearly : p.monthly) + sms}`);
      link.href = `${base.split('?')[0]}?plan=${p.id}`;
    };
    est.addEventListener('input', render);
    document.addEventListener('rh:choice', (e) => {
      const d = (e as CustomEvent).detail;
      if (d.key !== 'billing') return;
      render();
      if (d.user) track('pricing_toggle', { billing: d.value, location: 'pricing' });
    });
    render();
  }
  // Collapsible comparison groups.
  document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
    const btn = g.querySelector<HTMLButtonElement>('.grp')!;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      g.querySelectorAll<HTMLElement>('.grow').forEach((r) => { r.hidden = !open; });
    });
  });
</script>

<style>
  .hero { padding-top: clamp(56px, 7vw, 96px); padding-bottom: 40px; display: flex; flex-direction: column; gap: 28px; align-items: center; text-align: center; }
  .between { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 14px; align-items: stretch; }
  .plan { border-radius: 26px; padding: 28px; display: flex; flex-direction: column; gap: 14px; background: #fff; color: #10131A; border: 1px solid #E3E5DC; position: relative; }
  .plan.pop { background: #0B0D12; color: #fff; border-color: #0B0D12; }
  .plan :focus-visible { outline-color: #D4FF3A; }
  .pop-tag { position: absolute; top: -14px; left: 28px; background: #D4FF3A; color: #0B0D12; font-size: 12px; padding: 5px 12px; font-weight: 800; }
  .pname { margin: 0; font: 800 26px var(--font-display); }
  .who { font-size: 14px; opacity: .7; line-height: 1.45; min-height: 40px; }
  .price { display: flex; align-items: baseline; gap: 6px; min-height: 58px; }
  .price strong { font-size: 52px; letter-spacing: -.03em; line-height: 1; }
  .billed { font-size: 13px; opacity: .6; margin-top: -8px; }
  .pbtn { background: #0B0D12; color: #fff; }
  .plan.pop .pbtn { background: #D4FF3A; color: #0B0D12; }
  .ticks { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .ticks li { display: flex; gap: 10px; font-size: 14.5px; line-height: 1.4; }
  .ticks span { color: #2C4FE0; font-weight: 800; }
  .plan.pop .ticks span { color: #D4FF3A; }
  .est-sec { padding-top: 60px; padding-bottom: 40px; display: flex; flex-wrap: wrap; gap: 40px; align-items: center; }
  .est { flex: 1 1 520px; min-width: 0; padding: clamp(22px, 3vw, 34px); display: flex; flex-direction: column; gap: 18px; }
  .range.ink { accent-color: #0B0D12; }
  .add { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; border-radius: 14px; background: #F7F8F3; cursor: pointer; }
  .add-l { display: flex; align-items: center; gap: 12px; }
  .add input { width: 18px; height: 18px; accent-color: #0B0D12; flex: none; }
  .est-total { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px; padding-top: 16px; border-top: 2px solid #10131A; }
  .cmp-scroll { position: relative; overflow-x: auto; min-width: 0; max-width: 100%; }
  .ptab { width: 100%; min-width: 760px; border-collapse: separate; border-spacing: 0; }
  .ptab td, .ptab th { padding: 14px 16px; border-bottom: 1px solid #E3E5DC; font-size: 14.5px; text-align: center; }
  .ptab th[scope="row"] { text-align: left; font-weight: 500; color: #10131A; width: 34%; }
  .ptab thead th { background: #FAFAF6; font: 800 18px var(--font-display); }
  .ptab thead th.feat { text-align: left; font: 600 14px var(--font-ui); color: #535C6B; }
  .gcell { padding: 10px 0 0 !important; border: none !important; }
  .grp { display: flex; justify-content: space-between; align-items: center; width: 100%; padding: 18px 16px; border: none; background: #F1F2EA; font: 700 15px var(--font-ui); cursor: pointer; text-align: left; border-radius: 12px; color: #10131A; }
  .chev { display: inline-block; transition: transform .3s; }
  .grp[aria-expanded="true"] .chev { transform: rotate(180deg); }
  .yes { color: #0B7A55; font-weight: 800; }
  .no { color: #8A93A3; }
  .faq-sec { padding-top: 80px; padding-bottom: 100px; display: flex; flex-wrap: wrap; gap: 48px; }
</style>

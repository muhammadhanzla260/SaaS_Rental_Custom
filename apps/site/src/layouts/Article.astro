---
/** S8 article layout (blog posts and help articles): reading progress, sticky contents, related links. */
import Page from './Page.astro';
import type { MarkdownHeading } from 'astro';
import { SIGN_UP } from '~/lib/site';

interface Props {
  title: string;
  description: string;
  back: { href: string; label: string };
  kicker: string;
  meta: string;
  author?: string;
  headings: MarkdownHeading[];
  related: { href: string; kicker: string; title: string }[];
  jsonLd?: Record<string, unknown>[];
  draft?: boolean;
  cta?: boolean;
}
const { title, description, back, kicker, meta, author, headings, related, jsonLd, draft, cta = true } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
const initials = author ? author.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase() : '';
---
<Page title={title} description={description} vertical="auto" jsonLd={jsonLd} noindex={draft}>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
  <article class="wrap art">
    <header class="stack" style="gap:18px;max-width:820px">
      <a href={back.href} class="back">← {back.label}</a>
      <span class="eyebrow">{kicker}{draft && <span class="draft">Draft · not public</span>}</span>
      <h1 class="disp" style="font-size:clamp(38px,5vw,64px)">{title}</h1>
      <p class="lede">{description}</p>
      <span class="by">{author && <span class="av">{initials}</span>}{author && <strong>{author}</strong>}<span>{meta}</span></span>
    </header>
    <div class="body">
      {toc.length > 1 && (
        <nav class="toc" aria-label="On this page"><span class="eyebrow">On this page</span>{toc.map((h) => <a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a>)}</nav>
      )}
      <div class="prose" data-prose><slot /></div>
    </div>
    {cta && (
      <div class="cta"><span><strong>Try it with your own gear.</strong> Free trial, no card.</span><a href={SIGN_UP} class="btn btn-volt" data-track="start_trial" data-where="article">Start free trial</a></div>
    )}
  </article>
  {related.length > 0 && (
    <section class="wrap stack" style="gap:20px;padding-bottom:100px">
      <h2 class="h2" style="font-size:clamp(30px,3vw,40px)">Keep reading</h2>
      <div class="grid-auto" style="--min:260px;--gap:14px">{related.map((r) => <a href={r.href} class="card rel"><span class="eyebrow">{r.kicker}</span><strong>{r.title}</strong></a>)}</div>
    </section>
  )}
</Page>
<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const prose = document.querySelector<HTMLElement>('[data-prose]');
  if (bar && prose) {
    const update = () => {
      const r = prose.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight * 0.6)));
      bar.style.transform = `scaleX(${p})`;
    };
    addEventListener('scroll', update, { passive: true });
    update();
    const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc!, a]));
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, id) => a.toggleAttribute('aria-current', id === e.target.id)); }), { rootMargin: '-20% 0px -70% 0px' });
    prose.querySelectorAll('h2[id]').forEach((h) => io.observe(h));
  }
</script>
<style>
  .progress { position: fixed; left: 0; right: 0; top: 0; height: 3px; z-index: 50; }
  .progress span { display: block; height: 100%; background: #2C4FE0; transform: scaleX(0); transform-origin: left; }
  .art { padding-top: clamp(40px, 6vw, 80px); padding-bottom: 60px; display: flex; flex-direction: column; gap: 40px; }
  .back { color: #2C4FE0; font-weight: 650; font-size: 14.5px; }
  .draft { margin-left: 10px; padding: 3px 8px; border-radius: 999px; background: #FFF1DC; color: #8A4A00; font-size: 11px; letter-spacing: 0; text-transform: none; }
  .by { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: 14px; color: #535C6B; }
  .by strong { color: #10131A; }
  .av { width: 36px; height: 36px; border-radius: 50%; background: #0B0D12; color: #D4FF3A; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; font-size: 13px; }
  .body { display: grid; grid-template-columns: 240px minmax(0, 720px); gap: 56px; align-items: start; }
  .toc { position: sticky; top: 100px; display: flex; flex-direction: column; gap: 4px; }
  .toc a { padding: 8px 12px; border-left: 2px solid transparent; color: #535C6B; font-size: 14.5px; border-radius: 0 10px 10px 0; }
  .toc a[aria-current] { color: #10131A; background: #F1F2EA; border-left-color: #2C4FE0; }
  .prose :global(p), .prose :global(li) { font-size: 18px; line-height: 1.7; color: #353C48; }
  .prose :global(h2) { font: 800 30px/1.15 var(--font-display); letter-spacing: -.02em; margin: 40px 0 12px; scroll-margin-top: 100px; }
  .prose :global(blockquote) { margin: 24px 0; padding: 18px 22px; border-radius: 16px; background: #F1F2EA; border-left: 4px solid #D4FF3A; }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(a) { color: #2C4FE0; text-decoration: underline; }
  .cta { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; padding: 26px 28px; border-radius: 24px; background: #0B0D12; color: #fff; max-width: 1016px; }
  .rel { padding: 22px; display: flex; flex-direction: column; gap: 8px; transition: transform .25s var(--ease-out); }
  .rel:hover { transform: translateY(-3px); }
  .rel strong { font: 800 19px/1.25 var(--font-display); }
  @media (max-width: 900px) { .body { grid-template-columns: 1fr; } .toc { display: none; } }
</style>

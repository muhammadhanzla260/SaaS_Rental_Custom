<script>
  document.addEventListener('rh:choice', (e) => {
    const d = (e as CustomEvent).detail;
    if (d.key !== 'stop') return;
    const scope = e.target as HTMLElement;
    scope.querySelectorAll<HTMLElement>('.stop').forEach((s, i) => s.classList.toggle('done', i < +d.value));
    scope.querySelector<HTMLElement>('.track-on')!.style.width = `${(+d.value / 6) * 88}%`;
  });
</script>

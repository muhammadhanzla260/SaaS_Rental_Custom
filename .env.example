# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
# App runtime connection: the non-owner role `rental_app`. Row-level security applies.
DATABASE_URL=postgres://rental_app:rental_app_dev@127.0.0.1:54329/rental
# Owner connection: migrations and the background worker.
DATABASE_URL_OWNER=postgres://postgres:postgres@127.0.0.1:54329/rental
# Password given to the rental_app role by `pnpm db:migrate` (local/dev only; set your own on Neon).
APP_DB_PASSWORD=rental_app_dev

# --- Auth -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Maps (Mapbox) ----------------------------------------------------------------
# Public token (starts with pk.) for address search, the interactive map and map
# pictures. Create one at https://console.mapbox.com and restrict it to your domains.
# Read at runtime: restart the app after changing it, no rebuild needed.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional secret token (sk.) for server-side geocoding. Never sent to browsers.
MAPBOX_SECRET_TOKEN=

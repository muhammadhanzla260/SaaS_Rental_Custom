<script>
  // Workflow: earlier stops read as done and the progress line follows the current one.
  document.addEventListener('rh:choice', (e) => {
    const d = (e as CustomEvent).detail;
    if (d.key !== 'stop') return;
    const scope = (e.target as HTMLElement);
    const cur = +d.value;
    scope.querySelectorAll<HTMLElement>('.stop').forEach((s, i) => s.classList.toggle('done', i < cur));
    scope.querySelector<HTMLElement>('.track-on')!.style.width = `${(cur / 6) * 88}%`;
  });
</script>

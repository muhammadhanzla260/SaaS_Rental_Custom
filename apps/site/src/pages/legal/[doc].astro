---
/** S11 · Legal documents with tabs. The lawyer writes the final text; until then each page says so. */
import { getCollection, render } from 'astro:content';
import Page from '~/layouts/Page.astro';
import { fmtDate } from '~/lib/content';
import { COMPANY } from '~/data/company';

export async function getStaticPaths() {
  const docs = (await getCollection('legal')).sort((a, b) => a.data.order - b.data.order);
  return docs.map((doc) => ({ params: { doc: doc.id }, props: { doc, docs } }));
}
const { doc, docs } = Astro.props;
const { Content } = await render(doc);
---
<Page title={doc.data.title} description={`Rent Hatch ${doc.data.title.toLowerCase()}.`} vertical="auto">
  <section class="wrap layout">
    <nav class="tabs" aria-label="Legal documents"><span class="eyebrow">Legal</span>{docs.map((d) => <a href={`/legal/${d.id}`} aria-current={d.id === doc.id ? 'page' : undefined}>{d.data.title}</a>)}</nav>
    <article class="doc">
      {!doc.data.final && <p class="note">This page shows the structure of the document. The final wording is being written by our lawyer and will replace it before launch.</p>}
      <h1 class="disp" style="font-size:clamp(38px,4.6vw,60px)">{doc.data.title}</h1>
      <span style="color:#6B7383;font-size:14px">Last updated {fmtDate(doc.data.updated)} · Applies to Rent Hatch for event rental and car rental</span>
      <div class="md"><Content /></div>
      <p style="color:#535C6B">Questions? <a href={`mailto:${COMPANY.emails.privacy}`} style="color:#2C4FE0;font-weight:600">{COMPANY.emails.privacy}</a>{doc.id === 'cookies' && <> · <button type="button" class="linkbtn" data-cookie-settings>Change cookie settings</button></>}</p>
    </article>
  </section>
</Page>
<style>
  .layout { padding-top: clamp(40px, 6vw, 80px); padding-bottom: 100px; display: grid; grid-template-columns: 260px minmax(0, 760px); gap: 56px; align-items: start; }
  .tabs { position: sticky; top: 100px; display: flex; flex-direction: column; gap: 4px; }
  .tabs .eyebrow { margin-bottom: 8px; }
  .tabs a { padding: 10px 14px; border-radius: 12px; color: #353C48; font-weight: 600; font-size: 15px; }
  .tabs a:hover { background: #F1F2EA; }
  .tabs a[aria-current] { background: #0B0D12; color: #fff; }
  .doc { display: flex; flex-direction: column; gap: 16px; }
  .note { margin: 0; padding: 12px 16px; border-radius: 14px; background: #FFF1DC; color: #8A4A00; font-size: 14px; font-weight: 600; }
  .md :global(h2) { font: 800 24px/1.2 var(--font-display); margin: 28px 0 8px; }
  .md :global(p) { margin: 0; font-size: 17px; line-height: 1.7; color: #353C48; }
  .md :global(blockquote) { margin: 8px 0; padding: 18px 22px; border-radius: 16px; background: #F1F2EA; border-left: 4px solid #D4FF3A; }
  .linkbtn { background: none; border: none; padding: 0; color: #2C4FE0; font-weight: 600; cursor: pointer; }
  @media (max-width: 860px) {
    .layout { grid-template-columns: 1fr; gap: 24px; }
    .tabs { position: static; flex-direction: row; overflow-x: auto; }
    .tabs .eyebrow { display: none; }
    .tabs a { white-space: nowrap; }
  }
</style>

# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
# App runtime connection: the non-owner role `rental_app`. Row-level security applies.
DATABASE_URL=postgres://rental_app:rental_app_dev@127.0.0.1:54329/rental
# Owner connection: migrations and the background worker.
DATABASE_URL_OWNER=postgres://postgres:postgres@127.0.0.1:54329/rental
# Password given to the rental_app role by `pnpm db:migrate` (local/dev only; set your own on Neon).
APP_DB_PASSWORD=rental_app_dev

# --- Auth -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Encrypts saved SMTP / SMS / payment-gateway secrets. Same generator as above (32 bytes).
# Keep it safe: if it is lost, those secrets have to be entered again.
APP_ENCRYPTION_KEY=
# The platform owner's email: `pnpm platform:admin` grants console access to this login.
PLATFORM_OWNER_EMAIL=

# --- Platform email (verification, invites, sign-in links) -------------------------
# Optional in development: without it, emails are written to .data/mail/ instead of sent.
PLATFORM_SMTP_URL=
PLATFORM_MAIL_FROM="Tentpole <no-reply@example.com>"

# --- Maps (Mapbox) ----------------------------------------------------------------
# Public token (starts with pk.) for address search, the interactive map and map
# pictures. Create one at https://console.mapbox.com and restrict it to your domains.
# Read at runtime: restart the app after changing it, no rebuild needed.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional secret token (sk.) for server-side geocoding. Never sent to browsers.
MAPBOX_SECRET_TOKEN=

# Customer emails and texts. outbox (default outside production): written to .data/outbox; live: really sent.
MESSAGING_DELIVERY=outbox
# Public base URL used in email links (quote page). Defaults to BETTER_AUTH_URL.
APP_URL=

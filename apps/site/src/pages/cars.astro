---
/** C1 · Car rental home (early access). Every call to action collects an early-access sign-up. */
import Page from '~/layouts/Page.astro';
import Icon from '~/components/Icon.astro';
import Faq from '~/components/Faq.astro';
import Form from '~/components/Form.astro';
import { IC } from '~/lib/site';

const I = { ...IC, cal: IC.book, card: 'M3 6h18v12H3zM3 10h18', fuel: 'M4 20V5h9v15M4 10h9M13 8h3l2 2v8a1.5 1.5 0 0 1-3 0v-4h-2', doc: 'M5 4h14v16H5zM9 8h6M9 12h6M9 16h3', chart: IC.rep, globe: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM3 12h18M12 3c2.5 2.5 3.5 5.5 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.5-3.5-9s1-6.5 3.5-9z', bell: 'M6 16V11a6 6 0 0 1 12 0v5l2 2H4zM10 20h4', pin: IC.crew };
type B = [number, number, string, string];
const FLEETS: Record<string, { label: string; title: string; rows: [string, string, B[]][]; kpis: [string, string, string][] }> = {
  eco: { label: 'Economy & compact', title: 'Economy & compact · this week', rows: [['Toyota Corolla', 'TX 7KL-204', [[0, 3, 'J. Patel', '#D4FF3A'], [3.3, 7, 'Airport · Thu–Sun', '#C9B4FF']]], ['Honda Civic', 'TX 3MM-118', [[1, 4, 'R. Gomez', '#C9B4FF']]], ['Kia Rio', 'TX 9PL-660', [[0, 2, 'Service · oil', '#FF8A8E'], [2.3, 6, 'K. Lee', '#D4FF3A']]], ['Nissan Versa', 'TX 2FT-907', [[4, 7, 'Weekend · M. Ali', '#C9B4FF']]], ['Hyundai Elantra', 'TX 6YU-342', [[0, 7, 'Monthly · Uber driver', '#fff']]]], kpis: [['On rent', '9 / 12', '#fff'], ['Returns today', '3', '#C9B4FF'], ['Deposits held', '$2,700', '#D4FF3A']] },
  suv: { label: 'SUVs & vans', title: 'SUVs & vans · this week', rows: [['Toyota RAV4', 'TX 4KD-552', [[0, 3, 'J. Patel', '#D4FF3A'], [3.3, 5, 'Return check', '#FF8A8E']]], ['Ford Transit 15', 'TX 9RM-811', [[2, 7, 'Church trip · Wed–Sun', '#C9B4FF']]], ['Chevy Tahoe', 'TX 5TH-118', [[3, 7, 'M. Ruiz · Thu–Sun', '#D4FF3A']]], ['Honda Odyssey', 'TX 8OD-224', [[0, 4, 'Family trip', '#C9B4FF']]], ['Jeep Wrangler', 'TX 1JW-090', [[5, 7, 'Weekend', '#fff']]]], kpis: [['On rent', '11 / 14', '#fff'], ['One-way', '2', '#C9B4FF'], ['Deposits held', '$4,200', '#D4FF3A']] },
  truck: { label: 'Trucks & commercial', title: 'Trucks & commercial · this week', rows: [['Box truck 16 ft', 'TX 3BX-771', [[0, 2, 'Movers LLC', '#D4FF3A'], [2.3, 5, 'A. Khan move', '#C9B4FF']]], ['Pickup F-150', 'TX 6PF-450', [[0, 7, 'Contract · Cortez', '#fff']]], ['Cargo van', 'TX 2CV-338', [[1, 3, 'Delivery co.', '#C9B4FF'], [3.3, 4, 'Service', '#FF8A8E']]], ['Box truck 26 ft', 'TX 7BX-902', [[4, 7, 'Office move', '#D4FF3A']]], ['Flatbed', 'TX 4FB-115', [[2, 6, 'Site haul', '#C9B4FF']]]], kpis: [['On rent', '7 / 9', '#fff'], ['Miles out', '4,820', '#C9B4FF'], ['Deposits held', '$3,500', '#D4FF3A']] },
  lux: { label: 'Luxury & exotic', title: 'Luxury & exotic · this week', rows: [['Porsche 911', 'TX PRS-911', [[4, 7, 'Weekend · verified', '#D4FF3A']]], ['Tesla Model S', 'TX 2EV-930', [[0, 2, 'Airport', '#C9B4FF'], [2.3, 4, 'Detailing', '#FF8A8E']]], ['Range Rover', 'TX RR-1001', [[1, 6, 'Wedding · C. Ford', '#C9B4FF']]], ['Mercedes G-Wagon', 'TX GW-063', [[3, 5, 'Music video', '#D4FF3A']]], ['BMW M4', 'TX M4-440', [[5, 7, 'Weekend', '#fff']]]], kpis: [['On rent', '5 / 8', '#fff'], ['ID checks', '100%', '#C9B4FF'], ['Deposits held', '$14,000', '#D4FF3A']] },
};
const FLOATS = [['Licence verified', 'J. Patel · expires 2029', I.id, '#fff', '#10131A', '#F1EAFE', '#5B2DB0'], ['Deposit hold placed', '$300.00 · released on return', I.card, '#C9B4FF', '#1B1530', '#1B1530', '#C9B4FF'], ['Return check done', 'Fuel full · 6 photos · no new damage', I.cam, '#6D3FD6', '#fff', '#fff', '#6D3FD6']];
const FLOAT_POS = [['0px', '8px'], ['50%', '44%'], ['6%', '80%']];
const MARQ = ['Car rental', 'Van hire', 'Moving trucks', 'Luxury & exotic', 'Airport rentals', 'Rideshare fleets', 'Long-term rentals', 'Campervans', 'Pickup trucks', 'Cargo vans', 'Electric vehicles', 'Peer fleets'];
const PAINS = [
  ['The same car, promised to two customers.', 'Two bookings, one Corolla, one very angry airport pickup.', 'Every vehicle has its own calendar', 'Bookings check the exact car or class, including cleaning and service time, before they are confirmed.', 'Fleet calendar'],
  ['“That scratch was already there.”', 'No photos, no proof, no charge.', 'Photo inspections at pickup and return', 'Both sides of every rental are photographed and marked on the car, so new damage is obvious.', 'Inspections'],
  ['Fuel and mileage arguments.', 'Quarter tank? Half? Nobody wrote it down.', 'Fuel and odometer logged at both ends', 'Readings are captured at pickup and return, and extra miles or fuel are charged automatically.', 'Settlement'],
  ['Fake or expired licences.', 'You only find out after the car is gone.', 'Licence and ID checked before pickup', 'Customers upload their licence when they book. Expired or mismatched details are flagged.', 'Verification'],
  ['No-shows that cost you a weekend.', 'The car sat in the lot while three people asked for it.', 'Deposits and reminders that stop no-shows', 'A card hold at booking, a reminder the day before and clear cancellation rules.', 'Bookings'],
  ['Missed oil changes and services.', 'Until the warning light comes on mid-rental.', 'Maintenance due by date or mileage', 'Service reminders block the car from new bookings until it is done.', 'Maintenance'],
];
const STOPS = [
  ['Book', I.cal, 'Customers book online', 'A booking page on your site shows real availability by class, with your rates, extras and policies.', ['Live availability by vehicle and class', 'Weekly and monthly rates applied automatically', 'Pickup and drop-off locations']],
  ['Verify', I.id, 'Licence and ID checked up front', 'Customers upload their licence and ID after booking. Age, expiry and name are checked before pickup day.', ['Young-driver and age rules', 'Extra drivers added and checked', 'Flags before the keys go out']],
  ['Sign & hold', I.card, 'Agreement signed, deposit held', 'The rental agreement is e-signed and the security deposit is held on the card, not charged.', ['Typed e-signature with audit trail', 'Deposit hold by vehicle class', 'Rental paid up front or at pickup']],
  ['Pickup', I.cam, 'A 2-minute pickup check', 'Staff walk around the car with a phone: photos, marked damage, fuel level and odometer.', ['Tap-to-mark damage diagram', 'Fuel and mileage at pickup', 'Customer signs the condition report']],
  ['On rent', I.clock, 'Extensions and late returns, handled', 'Customers extend online, reminders go out before return time and late fees apply on their own.', ['Online extensions', 'Return reminders by text', 'Late return fees']],
  ['Return', I.check, 'Return check against pickup', 'The same walk-around compares with pickup, so only new damage, fuel and extra miles are charged.', ['Side-by-side with pickup photos', 'Extra miles and fuel priced', 'Damage priced from your repair list']],
  ['Settle', I.doc, 'Charges taken, deposit released', 'Extra charges come out of the deposit, the rest is released and the receipt goes out automatically.', ['Automatic settlement', 'Receipt with photos attached', 'Tolls and fines recharged later']],
] as const;
// [id, name, left, top, width, height, repair cents]
const ZONES: [string, string, string, string, string, string, number][] = [['fbump', 'Front bumper', '18%', '1%', '64%', '10%', 15000], ['hood', 'Bonnet', '20%', '12%', '60%', '22%', 15000], ['roof', 'Roof', '20%', '38%', '60%', '29%', 15000], ['rbump', 'Rear bumper', '18%', '87%', '64%', '11%', 18000], ['lfd', 'Left front door', '4%', '35%', '15%', '18%', 22000], ['lrd', 'Left rear door', '4%', '55%', '15%', '18%', 22000], ['rfd', 'Right front door', '81%', '35%', '15%', '18%', 22000], ['rrd', 'Right rear door', '81%', '55%', '15%', '18%', 15000], ['trunk', 'Boot', '20%', '68%', '60%', '18%', 14000], ['wind', 'Windscreen', '22%', '23%', '56%', '9%', 30000]];
const CLASSES = { eco: ['Economy', 4500, 20000], suv: ['SUV', 7900, 30000], van: ['Van', 9500, 30000], lux: ['Luxury', 18900, 100000] } as const;
const EXTRAS: [string, string, number, 'day' | 'once', number?][] = [['seat', 'Child seat', 800, 'day', 5600], ['gps', 'GPS unit', 600, 'day'], ['driver', 'Extra driver', 1000, 'day'], ['cover', 'Full damage cover', 2200, 'day'], ['young', 'Driver under 25', 2500, 'day'], ['oneway', 'One-way return', 7500, 'once']];
const FEATS = [['Fleet calendar by vehicle', 'See every car and class by the hour, with cleaning and service time held.', I.cal, '#F1EAFE', '#5B2DB0'], ['Online booking widget', 'Real availability, rates and extras on your own website.', I.globe, '#E6ECFF', '#233FB8'], ['Licence & ID checks', 'Customers upload before pickup; age and expiry are checked.', I.id, '#E3F5EC', '#0B6145'], ['Digital rental agreement', 'E-signed with the condition report attached.', I.doc, '#FFF1DC', '#8A4A00'], ['Deposit holds', 'Held by class, released automatically after return.', I.card, '#F1EAFE', '#5B2DB0'], ['Pickup & return photos', 'Tap-to-mark damage with side-by-side comparison.', I.cam, '#FDE7E8', '#A31F25'], ['Mileage & fuel charges', 'Included miles per day, extra miles and fuel priced.', I.fuel, '#E0F2F7', '#0A5566'], ['Extras & cover', 'Child seats, GPS, extra drivers and damage cover.', I.star, '#FFF1DC', '#8A4A00'], ['Maintenance by mileage', 'Services due by date or miles block new bookings.', I.wrench, '#E6ECFF', '#233FB8'], ['Multi-location & one-way', 'Pick up in one branch, return to another.', I.pin, '#E3F5EC', '#0B6145'], ['Reminders & extensions', 'Return reminders, online extensions and late fees.', I.bell, '#F1EAFE', '#5B2DB0'], ['Fleet reports', 'Utilisation, revenue per vehicle and damage history.', I.chart, '#E0F2F7', '#0A5566']];
const KINDS = [['Car rental', 'Economy to premium, by the day, week or month.', I.car, '#6D3FD6', ['Classes', 'Weekly rates', 'Airport pickup']], ['Vans & trucks', 'Moving vans, cargo vans and box trucks for people and businesses.', I.van, '#2C4FE0', ['Per-mile pricing', 'Business accounts', 'One-way']], ['Luxury & exotic', 'High-value cars with bigger holds and stricter checks.', I.star, '#B0306A', ['Large deposits', 'ID checks', 'Photo proof']], ['Long-term & subscription', 'Monthly rentals for rideshare drivers and businesses.', I.key, '#0B7A55', ['Monthly billing', 'Auto-charge', 'Service schedule']]] as const;
const PLANS = [['Fleet 15', 'Up to 15 vehicles', '$59', '/ month', ['1 location · 3 users', 'Bookings & fleet calendar', 'Licence checks & e-sign', 'Pickup & return inspections', 'Deposit holds'], false, 'Join early access', '#access'], ['Fleet 60', 'Up to 60 vehicles', '$149', '/ month', ['3 locations · 10 users', 'Everything in Fleet 15', 'Online booking widget', 'Maintenance by mileage', 'SMS reminders & extensions'], true, 'Join early access', '#access'], ['Fleet 200', 'Up to 200 vehicles', '$349', '/ month', ['Unlimited locations', 'Everything in Fleet 60', 'One-way rentals', 'Fleet reports', 'Priority support'], false, 'Join early access', '#access'], ['Enterprise', '200+ vehicles', 'Custom', '', ['Everything in Fleet 200', 'Telematics when released', 'SSO & custom roles', 'Dedicated manager', 'Data migration'], false, 'Talk to us', '/demo?rents=cars']] as const;
const ROAD = [['1', 'Designing with operators', 'Now', 'We are shaping inspections, rates and checks with real fleet owners.', true], ['2', 'Private beta', 'Next', 'Early-access members run real rentals with us on hand to help.', false], ['3', 'Public launch', 'Later', 'Open sign-up, with launch pricing locked in for beta members.', false]] as const;
const FAQS: [string, string][] = [
  ['When does car rental launch?', 'It is in design now with a small group of operators. Early-access members join a private beta first, then we open it up. Join the list and we will keep you posted with real dates, not guesses.'],
  ['Can customers book on my own website?', 'Yes. A booking page and an embeddable widget show your real availability, rates and extras, and take the deposit hold.'],
  ['Do you charge the deposit or just hold it?', 'It is a card hold, not a charge. Damage, fuel or extra miles are taken from it at return, and the rest is released.'],
  ['Does it work for vans, trucks and luxury cars?', 'Yes. Set classes, rates, mileage rules and deposit holds per class, from economy cars to box trucks and supercars.'],
  ['Can I track mileage and services?', 'Odometer readings at every pickup and return keep mileage current. Services due by date or mileage block the car from new bookings.'],
  ['Do you support GPS trackers and telematics?', 'Not at launch. Integrations with trackers are on the roadmap, and early-access members help us choose which ones come first.'],
  ['How are tolls and traffic fines handled?', 'Add them to a closed rental later, with the evidence attached, and charge the card on file with a receipt.'],
];
---
<Page
  title="Rent Hatch for car & vehicle rental · Early access"
  description="Car rental software that books every vehicle, checks every licence, photographs every scratch and settles mileage, fuel and deposits. Join early access and lock in launch pricing."
  vertical="cars"
  nav="dark"
  active="home"
>
  <div class="cw">
  <!-- HERO -->
  <section class="hero" data-scope data-fleet="eco">
    <div class="grid-bg"></div>
    <div class="glow" style="width:640px;height:640px;background:#6D3FD6;opacity:.5;right:-140px;top:-120px;animation:drift 14s ease-in-out infinite"></div>
    <div class="glow" style="width:380px;height:380px;background:#D4FF3A;opacity:.1;left:-120px;bottom:-160px"></div>
    <div class="wrap hero-in">
      <div class="stack" style="flex:1 1 520px;min-width:0;gap:26px">
        <a href="#access" class="chip rise ea-chip"><span>EARLY ACCESS</span>Car rental is launching soon. Join the first operators →</a>
        <h1 class="disp rise" style="--d:80ms;font-size:clamp(46px,5.6vw,80px)">Rent out cars. <span class="v">Not your weekends.</span></h1>
        <p class="rise hero-lede" style="--d:160ms">Car rental software that books every vehicle, checks every licence, photographs every scratch and settles mileage, fuel and deposits for you.</p>
        <div class="rise stack" style="--d:240ms;gap:10px">
          <span id="fleet-l" style="font-size:13px;font-weight:600;color:#B9B2D0">See it with your fleet</span>
          <div class="seg vseg" role="radiogroup" aria-labelledby="fleet-l" data-choice="fleet" data-url>
            {Object.entries(FLEETS).map(([id, f], i) => <button type="button" class="segb" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-value={id} style="height:44px">{f.label}</button>)}
          </div>
        </div>
        <div class="rise stack" style="--d:300ms;gap:12px" data-form-root>
          <Form kind="early-access" id="cars-hero" track="join_waitlist" source="cars-hero" class="hero-form">
            <label for="ch-email" class="sr-only">Work email</label>
            <input id="ch-email" name="email" class="input" type="email" required autocomplete="email" placeholder="you@yourfleet.com" />
            <button type="submit" class="btn btn-violet">Get early access</button>
            <a href="/demo?rents=cars" class="btn btn-ghost" style="border-color:#3B2D66">Book a demo</a>
          </Form>
          <div class="hero-ok" data-success tabindex="-1"><span>✓</span>You're in. We'll invite you to the private beta.</div>
          <span style="font-size:13.5px;color:#9A93B5">Early access members help shape it and lock in launch pricing.</span>
        </div>
      </div>
      <div class="hero-vis">
        {Object.entries(FLEETS).map(([id, f], fi) => (
          <div class="hero-fleet" data-when={`fleet:${id}`} hidden={fi !== 0} role="img" aria-label={`Preview of a car rental fleet calendar: ${f.title}`}>
            <div class="win">
              <div class="win-bar"><span style="background:#FF5F57"></span><span style="background:#FEBC2E"></span><span style="background:#28C840"></span><span class="mono">app.renthatch.com/fleet · preview</span></div>
              <div class="stack" style="padding:22px;gap:12px">
                <div class="between"><strong style="font-size:19px">{f.title}</strong><span class="mono" style="font-size:12px;color:#9A93B5">Mon – Sun</span></div>
                <div class="mono wk"><span></span>{['M', 'T', 'W', 'T', 'F', 'S', 'S'].map((d) => <span>{d}</span>)}</div>
                {f.rows.map(([car, plate, blocks], i) => (
                  <div class="frow" style={`animation-delay:${150 + i * 110}ms`}>
                    <span class="stack"><strong style="font-size:13.5px">{car}</strong><span class="mono" style="font-size:11px;color:#9A93B5">{plate}</span></span>
                    <span class="flane">{blocks.map(([a, z, t, c]) => <span class="fblk" style={`left:${(a / 7) * 100}%;width:${((z - a) / 7) * 100}%;background:${c};animation-delay:${150 + i * 110}ms`}>{t}</span>)}</span>
                  </div>
                ))}
                <div class="kpis">{f.kpis.map(([k, v, c]) => <div><div style="font-size:11.5px;color:#9A93B5">{k}</div><div class="mono" style={`font-size:17px;font-weight:600;color:${c}`}>{v}</div></div>)}</div>
              </div>
            </div>
          </div>
        ))}
        {FLOATS.map(([t, s, icon, bg, fg, ib, ic], i) => (
          <div class="cyc float" aria-hidden="true" style={`--d:${i * 3}s;left:${FLOAT_POS[i]![0]};top:${FLOAT_POS[i]![1]};background:${bg};color:${fg}`}>
            <span class="float-ic" style={`background:${ib}`}><Icon d={icon} size={18} stroke={ic} width={2.4} /></span>
            <span class="stack" style="gap:1px">{t}<span style="font-size:12px;font-weight:500;opacity:.65">{s}</span></span>
          </div>
        ))}
      </div>
    </div>
    <div class="marq-wrap">
      <ul class="marq" aria-label="Built for these fleets">
        {[...MARQ, ...MARQ].map((t, i) => <li class="chip" aria-hidden={i >= MARQ.length ? 'true' : undefined}><span style={`background:${['#C9B4FF', '#D4FF3A', '#6E8BFF', '#FF8FC7'][i % 4]}`}></span>{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- PAINS -->
  <section class="wrap sec" data-scope style="padding-top:110px">
    <div class="rv sec-head"><div class="stack" style="gap:16px;max-width:740px"><span class="eyebrow">Sound familiar?</span><h2 class="h2">Every car rental headache, <span class="vio">handled.</span></h2></div><button type="button" class="btn btn-line" data-flip-all data-on="Show the problems" data-off="Fix them all">Fix them all</button></div>
    <div class="flips">
      {PAINS.map(([pain, painSub, fix, fixSub, where]) => (
        <button type="button" class="flip rv" aria-pressed="false" aria-label={`Problem: ${pain} Fixed: ${fix}. ${fixSub}`}>
          <span class="flip-in" style="display:block">
            <span class="face" style="background:#fff;border:1px solid #E3E5DC"><span class="between"><span class="chip tag-bad">✕ PROBLEM</span><span style="font-size:13px;color:#6B7383">Tap to fix →</span></span><strong class="flip-t">{pain}</strong><span class="flip-s">{painSub}</span></span>
            <span class="face back" style="background:#1B1530;color:#fff"><span class="between"><span class="chip tag-good">✓ FIXED</span><span style="font-size:13px;color:#9A93B5">{where}</span></span><strong class="flip-t">{fix}</strong><span class="flip-s" style="color:#B9B2D0">{fixSub}</span></span>
          </span>
        </button>
      ))}
    </div>
  </section>

  <!-- JOURNEY -->
  <section id="journey" class="journey">
    <div class="wrap stack" style="gap:44px" data-scope data-tour="4200" data-stop="0">
      <div class="rv stack" style="gap:14px;max-width:760px"><span class="eyebrow" style="color:#9A93B5">One rental, start to finish</span><h2 class="h2">From online booking to deposit released</h2></div>
      <div class="stops-scroll">
        <div class="stops" role="tablist" aria-label="Rental journey" data-choice="stop">
          <span class="track"></span><span class="track-on"></span>
          {STOPS.map(([t, icon], i) => <button type="button" role="tab" class="stop" id={`cj-t${i}`} aria-controls={`cj-p${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-value={String(i)}><span class="dot"><Icon d={icon} size={22} /></span>{t}</button>)}
        </div>
      </div>
      {STOPS.map(([, , h, p, pts], i) => (
        <div role="tabpanel" id={`cj-p${i}`} aria-labelledby={`cj-t${i}`} class="mock jcard" data-when={`stop:${i}`} hidden={i !== 0}>
          <div class="stack" style="flex:1 1 360px;min-width:0;gap:12px"><span class="mono" style="color:#C9B4FF;font-size:13px">Step {i + 1} of 7</span><strong style="font:800 34px/1.05 var(--font-display)">{h}</strong><p style="margin:0;font-size:16.5px;line-height:1.6;color:#B9B2D0">{p}</p></div>
          <ul class="pts">{pts.map((t, j) => <li style={`animation-delay:${j * 90}ms`}><span aria-hidden="true">✓</span>{t}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <!-- INSPECTION -->
  <section id="inspect" class="wrap sec" style="padding-top:110px">
    <div class="rv sec-head"><div class="stack" style="gap:16px;max-width:760px"><span class="eyebrow">Pickup &amp; return inspections</span><h2 class="h2">“That scratch was already there.” <span class="vio">Not anymore.</span></h2></div><p class="lede" style="max-width:420px">Try it: switch to Return, tap the car to mark new damage, then set fuel and mileage. Watch the deposit settle.</p></div>
    <div class="insp" data-scope data-mode="ret" data-insp data-zones={JSON.stringify(ZONES.map(([id, name, , , , , c]) => [id, name, c]))}>
      <div class="rv car-panel">
        <div class="between" style="flex-wrap:wrap"><span class="stack"><strong style="font-size:18px">Toyota RAV4 · TX 4KD-552</strong><span style="font-size:13px;color:#9A93B5">Rental R-1187 · J. Patel · 3 days</span></span>
          <div class="tog" role="radiogroup" aria-label="Inspection" data-choice="mode"><button type="button" class="togb" role="radio" aria-checked="false" data-value="pick">Pickup</button><button type="button" class="togb" role="radio" aria-checked="true" data-value="ret">Return</button></div>
        </div>
        <div class="car">
          <svg viewBox="0 0 300 560" width="100%" height="100%" aria-hidden="true" style="position:absolute;inset:0"><rect x="40" y="20" width="220" height="520" rx="90" fill="#2A2140" /><rect x="60" y="120" width="180" height="90" rx="30" fill="#151124" /><rect x="62" y="380" width="176" height="70" rx="26" fill="#151124" /><rect x="62" y="215" width="176" height="160" rx="18" fill="#3B2D66" /><rect x="22" y="110" width="22" height="70" rx="10" fill="#0B0D12" /><rect x="256" y="110" width="22" height="70" rx="10" fill="#0B0D12" /><rect x="22" y="380" width="22" height="70" rx="10" fill="#0B0D12" /><rect x="256" y="380" width="22" height="70" rx="10" fill="#0B0D12" /><rect x="70" y="26" width="40" height="12" rx="6" fill="#D4FF3A" /><rect x="190" y="26" width="40" height="12" rx="6" fill="#D4FF3A" /><rect x="70" y="522" width="40" height="10" rx="5" fill="#FF5A5F" /><rect x="190" y="522" width="40" height="10" rx="5" fill="#FF5A5F" /></svg>
          {ZONES.map(([id, name, l, t, w, h]) => (

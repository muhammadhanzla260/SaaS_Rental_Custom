---
/** The small four-tile bullet from the logo. Takes the text colour unless `color` is set. */
interface Props { size?: number; color?: string }
const { size = 11, color = 'currentColor' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" style="flex:none"><g fill={color}><rect x="2" y="2" width="9" height="9" rx="2.4" /><rect x="13" y="2" width="9" height="9" rx="2.4" /><rect x="2" y="13" width="9" height="9" rx="2.4" /><rect x="13" y="13" width="9" height="9" rx="2.4" transform="rotate(24 13 22)" /></g></svg>

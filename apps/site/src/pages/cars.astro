<script>
  const money = (c: number) => (c < 0 ? '−' : '') + '$' + (Math.abs(c) / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  const row = (k: string, s: string, v: string, color = '#10131A') => `<div class="row" style="font-size:14.5px"><span>${k}<span style="display:block;font-size:12px;color:#6B7383">${s}</span></span><span class="mono" style="color:${color}">${v}</span></div>`;

  // Inspection demo: tap zones in Return mode; fuel and mileage settle the $300 hold.
  const insp = document.querySelector<HTMLElement>('[data-insp]');
  if (insp) {
    const zones: [string, string, number][] = JSON.parse(insp.dataset.zones!);
    const HOLD = 30000, FREE = 450;
    const fuel = insp.querySelector<HTMLInputElement>('#in-fuel')!;
    const miles = insp.querySelector<HTMLInputElement>('#in-mi')!;
    const out = (k: string, v: string) => { insp.querySelector(`[data-o="${k}"]`)!.textContent = v; };
    const render = () => {
      const ret = insp.dataset.mode === 'ret';
      const marked = [...insp.querySelectorAll<HTMLElement>('.zone.on:not(.pre)')].map((z) => zones.find((x) => x[0] === z.dataset.zone)!);
      const dmg = marked.reduce((a, z) => a + z[2], 0);
      const f = +fuel.value, mi = +miles.value;
      const fuelCost = Math.max(0, 8 - f) * 900;
      const extra = Math.max(0, mi - FREE);
      const miCost = extra * 25;
      out('fuel', `${f}/8 tank`);
      out('miles', `${mi} mi · ${FREE} free`);
      insp.querySelector('[data-ledger]')!.innerHTML = ret
        ? row('Security deposit hold', 'Placed at pickup', money(HOLD))
          + row('New damage', marked.length ? marked.map((z) => z[1]).join(', ') : 'Tap the car to mark damage', marked.length ? '−' + money(dmg) : money(0), marked.length ? '#A31F25' : '#10131A')
          + row('Fuel', f < 8 ? `${8 - f}/8 tank short` : 'Returned full', fuelCost ? '−' + money(fuelCost) : money(0), fuelCost ? '#A31F25' : '#10131A')
          + row('Extra miles', extra ? `${extra} mi over × $0.25` : 'Within allowance', miCost ? '−' + money(miCost) : money(0), miCost ? '#A31F25' : '#10131A')
          + row('Already there at pickup', 'Right rear door scratch · photo P-3', 'No charge', '#0B6145')
        : row('Damage recorded', 'Right rear door scratch · photo P-3', '1 mark', '#8A4A00')
          + row('Fuel', 'Customer must return the same level', `${f}/8`)
          + row('Odometer', 'Logged at pickup', '24,180 mi')
          + row('Deposit hold', 'Placed on card •4242', money(HOLD))
          + row('Condition report', 'Signed by the customer', 'Signed', '#0B6145');
      out('release', money(Math.max(0, HOLD - (ret ? dmg + fuelCost + miCost : 0))));
    };
    insp.addEventListener('click', (e) => {
      const z = (e.target as Element).closest<HTMLButtonElement>('.zone');
      if (!z || z.classList.contains('pre') || insp.dataset.mode !== 'ret') return;
      const on = z.classList.toggle('on');
      z.setAttribute('aria-pressed', String(on));
      render();
    });
    insp.addEventListener('input', render);
    insp.addEventListener('rh:choice', render);
    render();
  }

  // Rate calculator: weekly = 6 days' price, extras by day (some capped) or once, 10% sample tax.
  const rc = document.querySelector<HTMLElement>('[data-rates]');
  if (rc) {
    const CL: Record<string, [string, number, number]> = JSON.parse(rc.dataset.classes!);
    const EX: [string, string, number, 'day' | 'once', number?][] = JSON.parse(rc.dataset.extras!);
    const days = rc.querySelector<HTMLInputElement>('#rc-days')!;
    const out = (k: string, v: string) => { rc.querySelector(`[data-o="${k}"]`)!.textContent = v; };
    const render = () => {
      const c = CL[rc.dataset.cls!]!;
      const d = +days.value;
      const weeks = Math.floor(d / 7), rem = d % 7;
      const base = weeks * c[1] * 6 + Math.min(rem, 6) * c[1];
      const ex = EX.filter(([id]) => rc.querySelector<HTMLInputElement>(`[data-x="${id}"]`)!.checked).map(([, t, p, per, cap]) => [t, per === 'once' ? 'flat fee' : `$${(p / 100).toFixed(2)} a day${cap ? ', capped' : ''}`, per === 'once' ? p : Math.min(cap ?? Infinity, p * d)] as [string, string, number]);
      const sub = base + ex.reduce((a, r) => a + r[2], 0);
      const tax = Math.round(sub * 0.1);
      out('days', `${d} ${d === 1 ? 'day' : 'days'}${d >= 7 ? ' · weekly rate' : ''}`);
      rc.querySelector('[data-rows]')!.innerHTML = row(`${c[0]} · ${d} ${d === 1 ? 'day' : 'days'}`, weeks ? `${weeks} week${weeks > 1 ? 's' : ''} at 6 days${rem ? ` + ${rem} day${rem > 1 ? 's' : ''}` : ''}` : `$${(c[1] / 100).toFixed(2)} a day`, money(base))
        + ex.map(([t, s, v]) => row(t, s, money(v))).join('') + row('Tax', '10% sample rate', money(tax));
      out('total', money(sub + tax));
      out('hold', money(c[2]));
    };
    rc.addEventListener('input', render);
    rc.addEventListener('change', render);
    rc.addEventListener('rh:choice', render);
    render();
  }
</script>


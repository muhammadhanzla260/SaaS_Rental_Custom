---
interface Props { size?: number; animate?: boolean }
const { size = 34, animate = false } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 100 100" aria-hidden="true"><rect width="100" height="100" rx="26" fill="#D4FF3A" /><rect x="22" y="50" width="56" height="30" rx="6" fill="#0B0D12" /><rect x="22" y="38" width="56" height="9" rx="4" fill="#0B0D12" transform="rotate(-22 22 47)" class:list={[{ 'logo-lid': animate }]} /><circle cx="50" cy="64" r="5" fill="#D4FF3A" /></svg>
<style>
  .logo-lid { transform-origin: 22px 47px; animation: lid 3s ease-in-out infinite; }
  @keyframes lid { 0%, 100% { transform: rotate(-26deg); } 50% { transform: rotate(-18deg); } }
</style>

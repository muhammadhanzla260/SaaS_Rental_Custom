---
/** S12 · Not found. */
import Page from '~/layouts/Page.astro';
---
<Page title="Page not found" description="We couldn't find that page." vertical="auto" nav="dark" noindex>
  <section class="nf">
    <div class="grid-bg"></div>
    <div class="glow" style="width:520px;height:520px;background:#2C4FE0;opacity:.35;right:-120px;top:-160px"></div>
    <div class="wrap stack" style="position:relative;gap:22px;padding-top:clamp(64px,9vw,128px);padding-bottom:clamp(64px,9vw,128px)">
      <span class="eyebrow" style="color:#8A93A3">Error 404</span>
      <h1 class="disp rise" style="font-size:clamp(48px,7vw,104px)">This page got <span class="v">rented out.</span></h1>
      <p class="lede" style="color:#A3ABB9">We couldn't find what you were looking for. It may have moved, or the link has a typo.</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px">
        <a href="/events" class="btn btn-volt" data-set-vertical="events">Event rental home</a>
        <a href="/cars" class="btn btn-ghost" data-set-vertical="cars">Car rental home</a>
        <a href="/help" class="btn btn-ghost">Help center</a>
      </div>
    </div>
  </section>
</Page>
<style>
  .nf { position: relative; overflow: hidden; background: #0B0D12; color: #fff; }
  .nf :focus-visible { outline-color: #D4FF3A; }
</style>
